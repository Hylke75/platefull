# Kopieer naar .env.local. Alleen NEXT_PUBLIC_* komt in de browser; zet nooit de service-role key in de client.

# Supabase (EU-regio aanbevolen, §11.1). Lokaal: waarden uit `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optioneel, alleen server-side: nodig om het auth-account zelf te verwijderen bij een verwijderverzoek (U-12).
SUPABASE_SERVICE_ROLE_KEY=

# Optioneel: AI-laag (§7). Zonder deze variabelen draait de deterministische engine (U-11).
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=12000
