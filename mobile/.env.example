# Kopieer naar .env.local (lokaal) of zet als EAS-omgevingsvariabelen (development/preview/production).
# Beide waarden zijn publiek; RLS en de databasefuncties beschermen de data. Nooit een secret/service-role key.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Android-emulator: gebruik http://10.0.2.2:54321 i.p.v. 127.0.0.1. Fysiek toestel: het LAN-IP van je computer.
